@page "/notes"
@inject ApiClient Api

<PageTitle>Memory — Notes</PageTitle>

<h1>Notes</h1>

@if (loading)
{
    <p><em>Loading…</em></p>
}
else if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}
else
{
    <p class="text-muted">@notes.Count notes (most recent first)</p>
    @foreach (var n in notes)
    {
        <div class="card mb-2 p-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <span class="badge @KindBadgeClass(n.Kind)">@n.Kind</span>
                <span class="text-muted small">@n.CreatedAt.ToLocalTime() · @n.ContextDescription</span>
            </div>
            <div class="mt-1">@n.Content</div>
            @if (n.Keywords.Any())
            {
                <div class="mt-2">@foreach (var k in n.Keywords) { <span class="badge bg-secondary me-1">@k</span> }</div>
            }
            @if (n.Tags.Any())
            {
                <div class="mt-1">@foreach (var t in n.Tags) { <span class="badge bg-info me-1">@t</span> }</div>
            }
        </div>
    }
}

@code {
    bool loading = true;
    string? error;
    List<NoteDto> notes = new();

    protected override async Task OnInitializedAsync()
    {
        try { notes = await Api.ListNotesAsync(100); }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    static string KindBadgeClass(string kind) => kind switch
    {
        "Decision"    => "bg-primary",
        "Learning"    => "bg-success",
        "Error"       => "bg-danger",
        "Pattern"     => "bg-warning text-dark",
        "Observation" => "bg-info text-dark",
        _             => "bg-secondary",
    };
}
