@page "/secrets"
@inject ApiClient Api
@inject IJSRuntime JS

<PageTitle>Memory — Secrets</PageTitle>

<div class="secrets-header">
    <div>
        <h1><span class="secrets-icon-glow">🔐</span>Secrets</h1>
        @if (status is null)
        {
            <p class="secrets-subtitle">Loading…</p>
        }
        else if (!status.Configured)
        {
            <p class="secrets-subtitle muted">OpenBao is not configured on the server. Set <code>MEMORY_BAO_ADDR</code> and <code>MEMORY_BAO_TOKEN</code> on Memory.Api to enable this page.</p>
        }
        else
        {
            <p class="secrets-subtitle">
                <span class="provider-pill">OpenBao</span>
                <code>@status.Address</code>
                <span class="muted">·</span>
                mount <code>@status.Mount</code>
                <span class="muted">·</span>
                <span class="muted">@paths.Count @(paths.Count == 1 ? "path" : "paths")</span>
            </p>
        }
    </div>
    @if (status is { Configured: true })
    {
        <button class="btn-primary-soft" @onclick="StartNewPath">
            <span aria-hidden="true">+</span> New path
        </button>
    }
</div>

@if (toast is not null)
{
    <div class="toast-bar @(toast.IsError ? "error" : "success")">
        @toast.Message
    </div>
}

@if (status is { Configured: true })
{
    <div class="paths-grid">
        @if (newPathDraft is not null)
        {
            <div class="path-card draft">
                <div class="path-header">
                    <input class="path-name-input" placeholder="path-name (e.g. llm-memory)" @bind="newPathDraft.Path" autofocus />
                    <button class="btn-ghost danger" @onclick="CancelNewPath" title="Cancel">×</button>
                </div>
                <div class="kv-list">
                    @foreach (var kv in newPathDraft.Keys)
                    {
                        <div class="kv-row editing">
                            <input class="kv-key" placeholder="key__name" value="@kv.Name" @oninput="@(e => kv.Name = e.Value?.ToString() ?? "")" />
                            <input class="kv-value" placeholder="value" value="@kv.Value" @oninput="@(e => kv.Value = e.Value?.ToString() ?? "")" type="text" />
                        </div>
                    }
                </div>
                <div class="card-actions">
                    <button class="btn-ghost" @onclick="() => newPathDraft.Keys.Add(new EditableKv())">+ Add key</button>
                    <button class="btn-primary-soft" @onclick="SaveNewPath" disabled="@(string.IsNullOrWhiteSpace(newPathDraft.Path))">Save</button>
                </div>
            </div>
        }

        @foreach (var path in paths)
        {
            <SecretPathCard Path="@path" Mount="@(status?.Mount ?? "secret")" Api="Api" OnChanged="@OnPathChanged" OnDeleted="@OnPathDeleted" OnError="@ShowError" OnSuccess="@ShowSuccess" />
        }

        @if (paths.Count == 0 && newPathDraft is null)
        {
            <div class="empty">
                <div class="empty-icon">📭</div>
                <p>No secrets yet. Click <strong>New path</strong> to add the first one.</p>
            </div>
        }
    </div>
}

@code {
    SecretsStatusDto? status;
    List<string> paths = new();
    NewPathDraft? newPathDraft;
    Toast? toast;

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    async Task RefreshAsync()
    {
        try
        {
            status = await Api.GetSecretsStatusAsync();
            if (status is { Configured: true })
            {
                paths = await Api.ListSecretPathsAsync();
            }
        }
        catch (Exception ex)
        {
            ShowError($"Failed to load secrets: {ex.Message}");
        }
    }

    void StartNewPath() => newPathDraft = new NewPathDraft();
    void CancelNewPath() => newPathDraft = null;

    async Task SaveNewPath()
    {
        if (newPathDraft is null) return;
        var keys = newPathDraft.Keys
            .Where(k => !string.IsNullOrWhiteSpace(k.Name))
            .ToDictionary(k => k.Name.Trim(), k => k.Value);
        if (keys.Count == 0)
        {
            ShowError("Add at least one key/value pair before saving.");
            return;
        }
        try
        {
            var ok = await Api.WriteSecretDataAsync(newPathDraft.Path.Trim(), keys);
            if (!ok) { ShowError("API rejected the write."); return; }
            ShowSuccess($"Created {newPathDraft.Path}");
            newPathDraft = null;
            paths = await Api.ListSecretPathsAsync();
        }
        catch (Exception ex)
        {
            ShowError($"Save failed: {ex.Message}");
        }
    }

    async Task OnPathChanged(string path) => ShowSuccess($"Updated {path}");
    async Task OnPathDeleted(string path)
    {
        ShowSuccess($"Deleted {path}");
        paths = await Api.ListSecretPathsAsync();
    }

    void ShowError(string msg) { toast = new Toast(msg, true); _ = HideToastSoon(); }
    void ShowSuccess(string msg) { toast = new Toast(msg, false); _ = HideToastSoon(); }
    async Task HideToastSoon()
    {
        await Task.Delay(3500);
        toast = null;
        StateHasChanged();
    }

    sealed record Toast(string Message, bool IsError);

    sealed class NewPathDraft
    {
        public string Path { get; set; } = "";
        public List<EditableKv> Keys { get; set; } = new() { new EditableKv() };
    }

    public sealed class EditableKv
    {
        public string Name { get; set; } = "";
        public string Value { get; set; } = "";
    }
}
