@page "/search"
@inject ApiClient Api

<PageTitle>Memory — Search</PageTitle>

<h1>Search memory</h1>

<div class="input-group mb-2">
    <input class="form-control" @bind="query" @bind:event="oninput" @onkeyup="OnKey" placeholder="natural language query…" />
    <button class="btn btn-primary" @onclick="DoSearch" disabled="@(searching || string.IsNullOrWhiteSpace(query))">
        @(searching ? "Searching…" : "Search")
    </button>
</div>

<div class="card p-2 mb-3">
    <div class="d-flex flex-wrap gap-2 align-items-center">
        <span class="text-muted small">Filters:</span>
        <input class="form-control form-control-sm" style="width: 220px;" placeholder="tags (comma-separated)" @bind="tagsRaw" />
        <input type="date" class="form-control form-control-sm" style="width: 160px;" @bind="sinceDate" placeholder="since" />
        <input type="date" class="form-control form-control-sm" style="width: 160px;" @bind="untilDate" placeholder="until" />
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearFilters">Clear</button>
        @if (HasFilters)
        {
            <span class="badge bg-secondary">filtered</span>
        }
    </div>
    <div class="d-flex flex-wrap gap-1 align-items-center mt-2">
        <span class="text-muted small me-1">Kinds:</span>
        @foreach (var k in AllKinds)
        {
            var selected = selectedKinds.Contains(k);
            <button class="btn btn-sm @(selected ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => ToggleKind(k)" type="button">
                @k
            </button>
        }
    </div>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

@if (result is not null)
{
    <p class="text-muted">@result.Hits.Count hits / @result.TotalCandidates candidates</p>
    @foreach (var hit in result.Hits)
    {
        <div class="card mb-2 p-3">
            <div class="d-flex align-items-center gap-2 flex-wrap">
                <strong>score: @hit.Score.ToString("0.0000")</strong>
                @if (hit.Provenance is { } p)
                {
                    @if (p.FromVector) { <span class="badge bg-primary" title="dense vector match — score @p.VectorScore.ToString("0.0000")">vector</span> }
                    @if (p.FromBm25) { <span class="badge bg-success" title="BM25 fulltext match — score @p.Bm25Score.ToString("0.0000")">bm25</span> }
                    @if (p.FromGraph) { <span class="badge bg-info text-dark" title="graph PPR match — score @p.GraphScore.ToString("0.0000")">graph</span> }
                    @if (p.RerankerScore is { } r) { <span class="badge bg-warning text-dark" title="LLM relevance score">rerank: @r.ToString("0.00")</span> }
                }
            </div>
            <div class="mt-1">@hit.Content</div>
            @if (hit.RelatedEntityIds.Length > 0)
            {
                <div class="text-muted small mt-1">@hit.RelatedEntityIds.Length related entities</div>
            }
        </div>
    }
}

@code {
    static readonly string[] AllKinds = new[] { "Observation", "Decision", "Learning", "Error", "Pattern", "General" };

    string query = "";
    string tagsRaw = "";
    DateTime? sinceDate;
    DateTime? untilDate;
    HashSet<string> selectedKinds = new();
    bool searching = false;
    string? error;
    SearchResultDto? result;

    bool HasFilters => !string.IsNullOrWhiteSpace(tagsRaw) || sinceDate.HasValue || untilDate.HasValue || selectedKinds.Count > 0;

    void ToggleKind(string k)
    {
        if (!selectedKinds.Add(k)) selectedKinds.Remove(k);
    }

    async Task DoSearch()
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        searching = true;
        error = null;
        try
        {
            var tags = string.IsNullOrWhiteSpace(tagsRaw)
                ? null
                : tagsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Select(t => t.ToLowerInvariant())
                    .Distinct()
                    .ToList();
            DateTimeOffset? since = sinceDate is { } sd ? new DateTimeOffset(sd, TimeSpan.Zero) : null;
            DateTimeOffset? until = untilDate is { } ud ? new DateTimeOffset(ud.AddDays(1).AddTicks(-1), TimeSpan.Zero) : null;
            var kinds = selectedKinds.Count > 0 ? selectedKinds.ToList() : null;
            result = await Api.SearchAsync(query, 10, tags, since, until, kinds);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            searching = false;
        }
    }

    void ClearFilters()
    {
        tagsRaw = "";
        sinceDate = null;
        untilDate = null;
        selectedKinds.Clear();
    }

    Task OnKey(KeyboardEventArgs e) => e.Key == "Enter" ? DoSearch() : Task.CompletedTask;
}
