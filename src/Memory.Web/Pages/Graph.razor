@page "/graph"
@inject ApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Memory — Graph</PageTitle>

<h1>Knowledge Graph</h1>
<p class="text-muted">Entities and relationships for the current project. Dashed edges are bi-temporally invalidated (superseded).</p>

<div class="d-flex gap-2 align-items-center mb-2">
    <button class="btn btn-sm btn-outline-secondary" @onclick="ReloadAsync">Reload</button>
    <button class="btn btn-sm btn-outline-secondary" @onclick="FitAsync">Fit</button>
    <label class="form-check-label small ms-2">
        <input type="checkbox" class="form-check-input me-1" @bind="includeInvalidated" @bind:after="ReloadAsync" />
        show invalidated edges
    </label>
    <span class="text-muted small ms-auto">@nodeCount nodes · @edgeCount edges</span>
</div>

@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<div id="memory-graph" style="width: 100%; height: 70vh; border: 1px solid #dee2e6; border-radius: 0.375rem; background: #fafafa;"></div>

@code {
    bool includeInvalidated = false;
    string? error;
    int nodeCount;
    int edgeCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await ReloadAsync();
        }
    }

    async Task ReloadAsync()
    {
        error = null;
        try
        {
            var entities = await Api.ListEntitiesAsync(limit: 500);
            var edges = await Api.ListEdgesAsync(1000);

            var entityIds = entities.Select(e => e.Id).ToHashSet();
            var visibleEdges = edges
                .Where(e => includeInvalidated || e.InvalidatedAt is null)
                .Where(e => entityIds.Contains(e.From) && entityIds.Contains(e.To))
                .ToList();

            var nodes = entities.Select(e => new
            {
                id = e.Id.ToString(),
                label = e.Name,
                kind = e.Kind,
            });

            var edgeData = visibleEdges.Select(e => new
            {
                id = e.Id.ToString(),
                source = e.From.ToString(),
                target = e.To.ToString(),
                relation = e.Relation,
                invalidated = e.InvalidatedAt is not null,
            });

            nodeCount = entities.Count;
            edgeCount = visibleEdges.Count;

            await JS.InvokeVoidAsync("memoryGraph.render", "memory-graph", nodes, edgeData);
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    async Task FitAsync() => await JS.InvokeVoidAsync("memoryGraph.fit");

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("memoryGraph.destroy"); }
        catch { }
    }
}
