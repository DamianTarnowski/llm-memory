@inject IJSRuntime JS

<div class="path-card">
    <div class="path-header">
        <h3 class="path-name"><span class="muted">@Mount/</span>@Path</h3>
        <div class="path-meta">
            @if (data is not null)
            {
                <span class="muted small">v@(data.Version)</span>
                @if (data.CreatedAt is { } ts)
                {
                    <span class="muted small">· @ts.LocalDateTime.ToString("yyyy-MM-dd HH:mm")</span>
                }
            }
            <button class="btn-ghost danger" @onclick="ConfirmDelete" title="Delete this path">🗑</button>
        </div>
    </div>

    @if (loading)
    {
        <div class="kv-list">
            @for (var i = 0; i < 2; i++)
            {
                <div class="kv-row skeleton">
                    <div class="skeleton-line short"></div>
                    <div class="skeleton-line"></div>
                </div>
            }
        </div>
    }
    else if (data is null)
    {
        <p class="muted">Failed to load.</p>
    }
    else
    {
        <div class="kv-list">
            @foreach (var key in data.Keys.Keys.OrderBy(k => k))
            {
                <div class="kv-row @(editingKey == key ? "editing" : "")">
                    <code class="kv-key" title="@key">@PrettyKey(key)</code>
                    @if (editingKey == key)
                    {
                        <input class="kv-value" @bind="editingValue" type="text" @ref="editInput" />
                        <button class="btn-ghost" @onclick="@(() => SaveEdit(key))" title="Save">✓</button>
                        <button class="btn-ghost" @onclick="CancelEdit" title="Cancel">×</button>
                    }
                    else
                    {
                        <span class="kv-value masked">
                            @if (revealed.Contains(key))
                            {
                                <code>@data.Keys[key]</code>
                            }
                            else
                            {
                                <span class="dots">@MaskFor(data.Keys[key])</span>
                            }
                        </span>
                        <button class="btn-ghost" @onclick="@(() => ToggleReveal(key))" title="@(revealed.Contains(key) ? "Hide" : "Reveal")">
                            @(revealed.Contains(key) ? "🙈" : "👁")
                        </button>
                        <button class="btn-ghost" @onclick="@(async () => await CopyAsync(data.Keys[key]))" title="Copy value">📋</button>
                        <button class="btn-ghost" @onclick="@(() => StartEdit(key))" title="Edit">✏</button>
                        <button class="btn-ghost danger" @onclick="@(() => DeleteKey(key))" title="Delete this key">🗑</button>
                    }
                </div>
            }

            @if (newKeyDraft is not null)
            {
                <div class="kv-row editing">
                    <input class="kv-key" placeholder="key__name" @bind="newKeyDraft.Name" />
                    <input class="kv-value" placeholder="value" @bind="newKeyDraft.Value" type="text" />
                    <button class="btn-ghost" @onclick="SaveNewKey" title="Save">✓</button>
                    <button class="btn-ghost" @onclick="CancelNewKey" title="Cancel">×</button>
                </div>
            }
        </div>

        <div class="card-actions">
            @if (newKeyDraft is null)
            {
                <button class="btn-ghost" @onclick="StartNewKey">+ Add key</button>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Path { get; set; } = "";
    [Parameter] public string Mount { get; set; } = "secret";
    [Parameter] public ApiClient Api { get; set; } = null!;
    [Parameter] public EventCallback<string> OnChanged { get; set; }
    [Parameter] public EventCallback<string> OnDeleted { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }
    [Parameter] public EventCallback<string> OnSuccess { get; set; }

    SecretDataDto? data;
    bool loading = true;
    HashSet<string> revealed = new();
    string? editingKey;
    string editingValue = "";
    ElementReference editInput;
    Secrets.EditableKv? newKeyDraft;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    async Task LoadAsync()
    {
        loading = true;
        try
        {
            data = await Api.GetSecretDataAsync(Path);
            // Determine mount from response... actually status carries it; but we already
            // accept Mount as a parameter (defaulted). Status source is single, so default
            // is fine for now.
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Load {Path}: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    void ToggleReveal(string key)
    {
        if (!revealed.Add(key)) revealed.Remove(key);
    }

    string MaskFor(string value) => string.IsNullOrEmpty(value) ? "(empty)" : new string('•', Math.Min(28, Math.Max(8, value.Length)));

    string PrettyKey(string key) => key.Replace("__", ":").Replace("--", ":");

    void StartEdit(string key)
    {
        editingKey = key;
        editingValue = data?.Keys[key] ?? "";
    }

    void CancelEdit()
    {
        editingKey = null;
        editingValue = "";
    }

    async Task SaveEdit(string key)
    {
        if (data is null) return;
        var clone = new Dictionary<string, string>(data.Keys, StringComparer.Ordinal) { [key] = editingValue };
        try
        {
            var ok = await Api.WriteSecretDataAsync(Path, clone);
            if (!ok) { await OnError.InvokeAsync("Write rejected by API."); return; }
            CancelEdit();
            await LoadAsync();
            await OnChanged.InvokeAsync(Path);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Save failed: {ex.Message}");
        }
    }

    async Task DeleteKey(string key)
    {
        if (data is null) return;
        if (!await Confirm($"Delete key '{PrettyKey(key)}' from {Path}?")) return;
        var clone = new Dictionary<string, string>(data.Keys, StringComparer.Ordinal);
        clone.Remove(key);
        if (clone.Count == 0)
        {
            await OnError.InvokeAsync("Last key — delete the whole path with the trash icon instead.");
            return;
        }
        try
        {
            var ok = await Api.WriteSecretDataAsync(Path, clone);
            if (!ok) { await OnError.InvokeAsync("Delete rejected by API."); return; }
            await LoadAsync();
            await OnChanged.InvokeAsync(Path);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Delete failed: {ex.Message}");
        }
    }

    async Task ConfirmDelete()
    {
        if (!await Confirm($"Delete the whole path '{Path}' and all its keys? This wipes every version.")) return;
        try
        {
            var ok = await Api.DeleteSecretPathAsync(Path);
            if (!ok) { await OnError.InvokeAsync("Delete rejected by API."); return; }
            await OnDeleted.InvokeAsync(Path);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Delete failed: {ex.Message}");
        }
    }

    void StartNewKey() => newKeyDraft = new Secrets.EditableKv();
    void CancelNewKey() => newKeyDraft = null;

    async Task SaveNewKey()
    {
        if (data is null || newKeyDraft is null) return;
        if (string.IsNullOrWhiteSpace(newKeyDraft.Name))
        {
            await OnError.InvokeAsync("Key name is required.");
            return;
        }
        var clone = new Dictionary<string, string>(data.Keys, StringComparer.Ordinal)
        {
            [newKeyDraft.Name.Trim()] = newKeyDraft.Value,
        };
        try
        {
            var ok = await Api.WriteSecretDataAsync(Path, clone);
            if (!ok) { await OnError.InvokeAsync("Add rejected by API."); return; }
            newKeyDraft = null;
            await LoadAsync();
            await OnChanged.InvokeAsync(Path);
        }
        catch (Exception ex)
        {
            await OnError.InvokeAsync($"Add failed: {ex.Message}");
        }
    }

    async Task<bool> Confirm(string message) => await JS.InvokeAsync<bool>("confirm", message);

    async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            await OnSuccess.InvokeAsync("Copied to clipboard");
        }
        catch
        {
            await OnError.InvokeAsync("Clipboard not available in this browser context.");
        }
    }
}
