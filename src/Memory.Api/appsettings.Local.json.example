// Memory.Api uses a 3-layer secret-source chain (Memory.Secrets):
//   layer 1 (lowest priority): this file
//   layer 2: OpenBao, opt-in via MEMORY_BAO_ADDR + MEMORY_BAO_TOKEN (or AppRole)
//   layer 3 (highest priority): Azure Key Vault, opt-in via MEMORY_KV_URI + DefaultAzureCredential
// Later layers override earlier ones. To use ONLY this file, leave the env vars unset.
//
// Secret naming convention (both Azure KV and OpenBao disallow ':' in key names):
//   --  or  __  →  : (rewritten by the connector)
//   ConnectionStrings--memorydb (KV)  →  ConnectionStrings:memorydb
//   Llm__AzureOpenAi__ApiKey   (BAO) →  Llm:AzureOpenAi:ApiKey
//
// Local dev with the secondary subscription (which owns llmmemory-kv):
//   $env:AZURE_CONFIG_DIR = "$HOME\.azure-foundry"
//   $env:MEMORY_KV_URI    = "https://llmmemory-kv.vault.azure.net/"
//   $env:MEMORY_BAO_ADDR  = "http://127.0.0.1:8200"
//   $env:MEMORY_BAO_TOKEN = "<root-token-from-~/.config/openbao-dev-creds.json>"
// Default OpenBao mount = "secret", default path = "llm-memory" — override via
// MEMORY_BAO_KV_MOUNT / MEMORY_BAO_KV_PATHS (comma-separated).
{
  // Use the non-superuser memory_app role — superusers bypass row-level security
  // regardless of FORCE, so connecting as postgres silently disables tenancy
  // isolation. memory_app is created by migration 20260504210400_AddMemoryAppRole.
  // Migrations themselves still need a superuser; use postgres for `dotnet ef`.
  "ConnectionStrings": {
    "memorydb": "Host=localhost;Port=5435;Database=llm_memory;Username=memory_app;Password=memory_app"
  },
  "Storage": {
    "GraphName": "memory_graph",
    "Schema": "memory"
  },
  "Llm": {
    "ChatProvider": "AzureOpenAI",
    "ChatModel": "gpt-5.5",
    "EmbeddingProvider": "AzureOpenAI",
    "EmbeddingModel": "text-embedding-3-large",
    "EmbeddingDimensions": 3072,
    "AzureOpenAi": {
      "Endpoint": "https://YOUR_FOUNDRY.services.ai.azure.com",
      "ApiKey": "YOUR_KEY",
      "ChatDeployment": "gpt-5.5",
      "EmbeddingDeployment": "text-embedding-3-large"
    }
  },
  "Linking": {
    "Enabled": true,
    "NeighborCount": 5,
    "MinSimilarity": 0.30,
    "MinConfidence": 0.60
  },
  "ReflectionSchedule": {
    "Enabled": false,
    "InitialDelay": "00:05:00",
    "Interval": "06:00:00"
  },
  "MarkdownConnector": {
    "Enabled": false,
    "Path": "C:/Users/me/notes",
    "OrganizationId": "00000000-0000-0000-0000-000000000000",
    "UserId": "00000000-0000-0000-0000-000000000000",
    "ProjectId": "00000000-0000-0000-0000-000000000000",
    "PollIntervalSeconds": 60
  }
}
