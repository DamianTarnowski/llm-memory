{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "ConnectionString": "",
    "GraphName": "memory_graph",
    "Schema": "memory"
  },
  "Llm": {
    "ChatProvider": "AzureOpenAI",
    "ChatModel": "gpt-5-mini",
    "EmbeddingProvider": "OpenAI",
    "EmbeddingModel": "text-embedding-3-large",
    "EmbeddingDimensions": 3072
  },
  "QueryRouting": {
    "Enabled": false,
    "ModelOverride": "",
    "MaxRecentTurns": 6,
    "MaxVariants": 3,
    "MaxPromptChars": 6000,
    "MaxResultsCap": 50,
    "AllowDocumentRag": false
  }
}
